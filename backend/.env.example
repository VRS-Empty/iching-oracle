# Copy to .env and fill in real values. .env is gitignored — never commit it.
# On Render these are set as environment variables in the dashboard instead.

# Embedding provider — set ONE of these, matching the --provider used to build
# embeddings.json (query vectors must come from the same model as the corpus).
OPENAI_API_KEY=sk-...
# VOYAGE_API_KEY=pa-...

# Used by the Flask backend to call the Claude API
ANTHROPIC_API_KEY=sk-ant-...
